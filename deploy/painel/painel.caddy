# O painel, atras da borda (so HTTP, na rede interna). O HTTPS e o HSTS sao da borda.
{
	admin off
	auto_https off
}

:80 {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(), geolocation=(), browsing-topics=()"
		# A politica de conteudo: script so daqui e do login do Google; conexao so com a API, a
		# midia e o login; imagem daqui, da midia e do avatar do Google. O painel guarda a sessao
		# do time, entao nenhum outro site pode embuti-lo (clickjacking). O estilo embutido fica
		# liberado porque os dialogos injetam um <style> para travar a rolagem; o script, nao.
		# Os enderecos vem do ambiente do servico (stack-app.yml).
		Content-Security-Policy "default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com/gsi/style; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://*.googleusercontent.com {$MIDIA_URL}; connect-src 'self' {$API_URL} {$API_WSS_URL} {$MIDIA_URL} https://accounts.google.com/gsi/; frame-src {$QUADRO_URL} https://accounts.google.com/gsi/; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	# O que e do quadro mora na CDN, numa origem propria: o carregador, o quadro, a pagina
	# de acompanhamento e a pagina de teste do botao. Servidos daqui, dividiriam a origem com a
	# sessao do time.
	@doQuadro path /embed.html /tracking.html /v1/* /teste-do-botao.html /_headers
	handle @doQuadro {
		respond 404
	}

	# Os pedacos com nome de versao: um ano no cache. Primeiro os desta versao, depois os das
	# anteriores (ver iniciar.sh). Pedaco que nao existe e 404, e nunca o index.html: a tela
	# percebe e recarrega, em vez de tentar ler HTML como codigo.
	@pedacoAtual {
		path /assets/*
		file {
			root /srv/web
		}
	}
	handle @pedacoAtual {
		root * /srv/web
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle /assets/* {
		root * /srv/pedacos
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# O resto: o index.html e as rotas das telas, que caem nele. Sempre perguntando, para a
	# versao nova chegar no proximo carregamento.
	handle {
		root * /srv/web
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

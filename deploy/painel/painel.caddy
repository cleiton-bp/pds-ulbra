# O painel, atras da borda (so HTTP, na rede interna). O HTTPS e o HSTS sao da borda.
{
	admin off
	auto_https off
}

:80 {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(), geolocation=(), browsing-topics=()"
		# O painel guarda a sessao do time: nenhum outro site pode embuti-lo (clickjacking).
		Content-Security-Policy "frame-ancestors 'none'"
		-Server
	}

	# O que e do quadro mora na CDN, numa origem propria (V3): o carregador, o quadro, a pagina
	# de acompanhamento e a pagina de teste do botao. Servidos daqui, dividiriam a origem com a
	# sessao do time.
	@doQuadro path /embed.html /tracking.html /v1/* /teste-do-botao.html /_headers
	handle @doQuadro {
		respond 404
	}

	# Os pedacos com nome de versao: um ano no cache. Primeiro os desta versao, depois os das
	# anteriores (ver iniciar.sh). Pedaco que nao existe e 404, e nunca o index.html: a tela
	# percebe e recarrega, em vez de tentar ler HTML como codigo.
	@pedacoAtual {
		path /assets/*
		file {
			root /srv/web
		}
	}
	handle @pedacoAtual {
		root * /srv/web
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle /assets/* {
		root * /srv/pedacos
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# O resto: o index.html e as rotas das telas, que caem nele. Sempre perguntando, para a
	# versao nova chegar no proximo carregamento.
	handle {
		root * /srv/web
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

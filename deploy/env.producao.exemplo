# Os NOMES das variaveis da producao, e nenhum valor: o repositorio e publico. Os valores
# existem so na VPS (em deploy/.env.producao, fora do git e legivel so pelo dono) e com quem
# cuida do deploy. Para os que nao sao sorteados, peca ao time.
#
#   cp deploy/env.producao.exemplo deploy/.env.producao
#   deploy/scripts/gerar-segredos.sh deploy/.env.producao    # sorteia senhas e nomes de usuario
#   nano deploy/.env.producao                                # o resto, com os valores do time
#
# O implantar.sh recusa subir se faltar algum.

# Pedir ao time: os enderecos. A borda serve todos menos o do quadro, que fica na CDN.
PAINEL_URL=
API_URL=
MIDIA_URL=
EDITOR_URL=
QUADRO_URL=
# Pedir ao time: o dominio puro e o www, separados por virgula e entre aspas. Levam ao painel.
RAIZ_ENDERECO=

# Pedir ao time: o e-mail de contato da conta do certificado no Let's Encrypt. Aviso de
# vencimento ele nao manda mais: quem avisa se algo cair e o vigia de fora (deploy/README.md).
ACME_EMAIL=

# Pedir ao time: o client id do login com o Google (o mesmo no painel e na API).
GOOGLE_CLIENT_ID=

# Pedir ao time: o envio do convite por e-mail (SMTP). SMTP_SEGURANCA e StartTls ou
# SslOnConnect, conforme a porta; o nome do remetente com espaco vai entre aspas.
SMTP_HOST=
SMTP_PORT=
SMTP_SEGURANCA=
SMTP_USUARIO=
SMTP_SENHA=
SMTP_REMETENTE=
SMTP_NOME=

# Sorteados pelo gerar-segredos.sh na propria maquina: nunca saem dela.
# O banco: o superusuario, so para manutencao, e o da aplicacao.
BANCO_ADMIN_SENHA=
BANCO_SENHA=
# A fila.
FILA_USUARIO=
FILA_SENHA=
# A midia: o administrador do MinIO, so para preparar o balde, e um usuario para a API e
# outro para as copias, cada um com o minimo (deploy/midia/).
MIDIA_ADMIN_USUARIO=
MIDIA_ADMIN_SENHA=
MIDIA_API_USUARIO=
MIDIA_API_SENHA=
MIDIA_COPIAS_USUARIO=
MIDIA_COPIAS_SENHA=
# A chave que assina as sessoes do painel.
JWT_SIGNING_KEY=

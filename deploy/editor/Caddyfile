# O editor publicado so para leitura, atras da borda (so HTTP, na rede interna).
#
# No lugar da API de arquivos do Vite, os arquivos que a montagem exportou
# (tools/editor/scripts/exportar-leitura.mjs), nas mesmas rotas que o editor pede:
#   GET /api/<pasta>/files        -> /api/<pasta>/files.json
#   GET /api/<pasta>/file?name=X  -> /api/<pasta>/file/X.json
# Qualquer gravacao e recusada.
{
	admin off
	auto_https off
}

:80 {
	encode zstd gzip
	root * /srv/editor
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(), geolocation=(), browsing-topics=()"
		# O editor nao usa nada de fora: tudo daqui. O estilo embutido fica liberado porque o
		# desenho dos diagramas escreve estilo na pagina.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	@gravacao {
		path /api/*
		not method GET HEAD
	}
	handle @gravacao {
		header Content-Type "application/json; charset=utf-8"
		respond `{"error":"somente leitura"}` 403
	}

	@lista path_regexp lista ^/api/(modeling|use-cases)/files$
	handle @lista {
		rewrite * /api/{re.lista.1}/files.json
		header Cache-Control "no-cache"
		file_server
	}

	# O nome vem da consulta, mas o caminho e limpo antes de abrir o arquivo e nao sai da
	# raiz: "../" nao alcanca nada fora de /srv/editor.
	@arquivo path_regexp arquivo ^/api/(modeling|use-cases)/file$
	handle @arquivo {
		rewrite * /api/{re.arquivo.1}/file/{query.name}.json
		header Cache-Control "no-cache"
		file_server
	}

	handle /api/* {
		header Content-Type "application/json; charset=utf-8"
		respond `{"error":"rota não encontrada"}` 404
	}

	@pedacos path /assets/*
	header @pedacos Cache-Control "public, max-age=31536000, immutable"

	handle {
		try_files {path} /index.html
		file_server
	}
}

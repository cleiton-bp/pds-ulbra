# A borda: termina o HTTPS e entrega cada endereco ao servico dele, na rede interna. Os
# enderecos vem do deploy/.env.producao, pelo stack-app.yml.
{
	admin off
	# O contato da conta do certificado no Let's Encrypt, que nao manda mais aviso de vencimento.
	email {$ACME_EMAIL}
}

# O navegador passa a so usar HTTPS nestes enderecos por um ano.
(hsts) {
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
}

# Quem chama nao precisa saber qual servidor responde nem por onde a resposta passou.
(discreto) {
	header {
		-Server
		-Via
	}
}

# A raiz da API e da midia nao tem pagina nenhuma, e quem abre o endereco no navegador (vindo
# de um link, por exemplo) caia num erro. So a raiz e so a leitura vao para o painel: nenhuma
# chamada do sistema usa a raiz desses enderecos.
(raiz-para-o-painel) {
	@raiz {
		path /
		method GET HEAD
	}
	redir @raiz {$PAINEL_URL}
}

# O painel do time.
{$PAINEL_URL} {
	import hsts
	import discreto
	reverse_proxy painel:80
}

# A API, o tempo real (WebSocket) e a documentacao da API. Os cabecalhos de seguranca, o HSTS
# inclusive, a API poe sozinha. O IP de quem chama segue no X-Forwarded-For, e a API so le
# dele porque a rede da borda esta no TRUSTED_PROXIES.
{$API_URL} {
	import discreto
	import raiz-para-o-painel
	encode zstd gzip
	reverse_proxy api:8080
}

# A midia: o navegador envia e le aqui, com a permissao assinada que a API entrega.
{$MIDIA_URL} {
	import hsts
	import discreto
	import raiz-para-o-painel
	# O que o MinIO serve em /minio/ (administracao, chaves, metricas e as rotas internas)
	# nao tem o que fazer aqui fora: o implantar.sh prepara tudo pela rede interna. Fechado
	# na borda, nem chega ao MinIO quem tentar adivinhar a senha do administrador.
	@interno path /minio/*
	respond @interno 404
	reverse_proxy midia:9000
}

# O editor de modelagem, so leitura.
{$EDITOR_URL} {
	import hsts
	import discreto
	reverse_proxy editor:80
}

# O dominio puro e o www levam ao painel.
{$RAIZ_ENDERECO} {
	import hsts
	import discreto
	redir {$PAINEL_URL}{uri}
}

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Gera o XML dos comentarios para o Swagger descrever DTOs e view models.
         1591 avisa sobre membro publico sem comentario; nem todo membro precisa. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pds.ApiBase\Pds.ApiBase.csproj" />
  </ItemGroup>

</Project>

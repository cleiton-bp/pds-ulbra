<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <!-- So o dominio, e isso e deliberado.

       Este projeto fala com o armazenamento e nao sabe mais nada: ele nao
       referencia Pds.Service nem Pds.Data, entao nao tem como abrir transacao,
       montar consulta ou decidir regra. O que ele faz e implementar uma interface
       do dominio e assinar URL. Mesma forma do Pds.Workers com a fila. -->
  <ItemGroup>
    <ProjectReference Include="..\Pds.Domain\Pds.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" Version="4.0.103.3" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <!-- Publicada para uma plataforma (o Dockerfile), sai pre-compilada: o codigo da API e
         dos pacotes ja vai em codigo de maquina, e o primeiro pedido de cada rota nao
         espera a compilacao. No build do dia a dia, sem plataforma, nada muda. -->
    <PublishReadyToRun Condition="'$(RuntimeIdentifier)' != ''">true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DotNetEnv" Version="3.1.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="7.2.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- O site de documentacao. Como a pasta nao se chama wwwroot, o SDK nao a
         copia sozinho: sem isto ela ficaria de fora da publicacao. -->
    <None Remove="api-docs\**" />
    <Content Include="api-docs\**"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pds.Shared\Pds.Shared.csproj" />
    <ProjectReference Include="..\Pds.Service\Pds.Service.csproj" />
    <ProjectReference Include="..\Pds.Data\Pds.Data.csproj" />
    <ProjectReference Include="..\Pds.Workers\Pds.Workers.csproj" />
    <ProjectReference Include="..\Pds.Storage\Pds.Storage.csproj" />
    <ProjectReference Include="..\Pds.Email\Pds.Email.csproj" />
  </ItemGroup>

</Project>

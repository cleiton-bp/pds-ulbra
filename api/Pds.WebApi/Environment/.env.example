# Modelo. Copie para .env.local e preencha.
#
# Peca o .env.local a quem ja roda o projeto: o banco e compartilhado e a
# aplicacao no Google e registrada uma vez so, entao valor inventado nao sobe.
# Quem envia, manda por canal privado — nunca por commit ou grupo.


# --- precisa pedir ---

# Banco hospedado. Se a hospedagem oferecer dois enderecos, use o externo: o
# interno costuma resolver so de dentro dela. SSL Mode=Require e obrigatorio na
# maioria delas.
DB_CONNECTION_STRING=Host=<host>;Port=5432;Database=<banco>;Username=<usuario>;Password=<senha>;SSL Mode=Require;Trust Server Certificate=true;

# Client ID do Google Cloud. Nao ha client secret: o Sign-In acontece no painel.
GOOGLE_CLIENT_ID=


# --- voce mesmo gera ---

# openssl rand -base64 48
JWT_SIGNING_KEY=


# --- ja vem pronto ---

JWT_ISSUER=pds
JWT_AUDIENCE=pds.panel
JWT_EXPIRATION_HOURS=8

# Origens do painel, separadas por virgula. 5173 e a porta padrao do Vite.
CORS_ALLOWED_ORIGINS=http://localhost:5173

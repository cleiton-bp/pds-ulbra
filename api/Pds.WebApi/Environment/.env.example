# Modelo. Copie para .env.local e preencha.
#
# Peca o .env.local a quem ja roda o projeto: o banco e compartilhado e a
# aplicacao no Google e registrada uma vez so, entao valor inventado nao sobe.
# Quem envia, manda por canal privado — nunca por commit ou grupo.


# --- precisa pedir ---

# Banco hospedado. Se a hospedagem oferecer dois enderecos, use o externo: o
# interno costuma resolver so de dentro dela. SSL Mode=Require e obrigatorio na
# maioria delas.
DB_CONNECTION_STRING=Host=<host>;Port=5432;Database=<banco>;Username=<usuario>;Password=<senha>;SSL Mode=Require;Trust Server Certificate=true;

# Client ID do Google Cloud. Nao ha client secret: o Sign-In acontece no painel.
GOOGLE_CLIENT_ID=


# --- voce mesmo gera ---

# openssl rand -base64 48
JWT_SIGNING_KEY=


# --- ja vem pronto ---

JWT_ISSUER=pds
JWT_AUDIENCE=pds.panel
JWT_EXPIRATION_HOURS=8

# Origens do painel, separadas por virgula. 5173 e a porta padrao do Vite.
CORS_ALLOWED_ORIGINS=http://localhost:5173


# --- opcional: armazenamento de midia ---
#
# Sem as quatro primeiras a API sobe inteira e so o anexo fica indisponivel.
# Metade delas derruba a subida, dizendo qual falta. Os valores abaixo sao os do
# MinIO do docker-compose, que roda na sua maquina.

# MEDIA_STORAGE_ENDPOINT=http://localhost:9000
# MEDIA_STORAGE_ACCESS_KEY=pds
# MEDIA_STORAGE_SECRET_KEY=pdspdspds
# MEDIA_STORAGE_BUCKET=pds-media

# Endereco com que o NAVEGADOR alcanca o armazenamento, e o unico com que se
# assina. So precisa quando e diferente do de cima — a API num container fala
# com `minio:9000`, e o navegador so conhece `localhost:9000`. Padrao: o de cima.
# MEDIA_STORAGE_PUBLIC_ENDPOINT=

# Padroes: us-east-1, true (balde no caminho), 2, 5 e 15 minutos, 20 por minuto.
# MEDIA_STORAGE_REGION=us-east-1
# MEDIA_STORAGE_FORCE_PATH_STYLE=true
# MEDIA_STORAGE_UPLOAD_URL_MINUTES=2
# MEDIA_STORAGE_READ_URL_MINUTES=5
# MEDIA_STORAGE_PLAYBACK_URL_MINUTES=15
# MEDIA_UPLOAD_RATE_LIMIT_PER_MINUTE=20


# --- opcional: API atras de proxy ---
#
# Proxies cujo X-Forwarded-For vale, separados por virgula: endereco (10.0.0.5)
# ou rede (10.0.0.0/8). Vazio, o cabecalho e ignorado e o IP e o da conexao —
# o certo rodando local. Valor que nao e endereco nem rede derruba a subida.
# TRUSTED_PROXIES=

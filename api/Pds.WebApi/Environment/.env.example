# Modelo. Copie para .env.local e preencha.
#
# Peca o .env.local a quem ja roda o projeto: o banco e compartilhado e a
# aplicacao no Google e registrada uma vez so, entao valor inventado nao sobe.
# Quem envia, manda por canal privado — nunca por commit ou grupo.


# --- precisa pedir ---

# Banco hospedado. Se a hospedagem oferecer dois enderecos, use o externo: o
# interno costuma resolver so de dentro dela. SSL Mode=Require e obrigatorio na
# maioria delas.
DB_CONNECTION_STRING=Host=<host>;Port=5432;Database=<banco>;Username=<usuario>;Password=<senha>;SSL Mode=Require;Trust Server Certificate=true;

# Client ID do Google Cloud. Nao ha client secret: o Sign-In acontece no painel.
GOOGLE_CLIENT_ID=


# --- voce mesmo gera ---

# openssl rand -base64 48
JWT_SIGNING_KEY=


# --- ja vem pronto ---

JWT_ISSUER=pds
JWT_AUDIENCE=pds.panel
JWT_EXPIRATION_HOURS=8

# Origens do painel, separadas por virgula. 5173 e a porta padrao do Vite.
CORS_ALLOWED_ORIGINS=http://localhost:5173


# --- opcional: a fila ---
#
# A fila da espera antes de o lado publico mudar, dos prazos do pedido de
# informacao e da saida do e-mail. Sem ela a API sobe inteira, mas a espera fica
# indisponivel, o pedido de informacao nao encerra sozinho no prazo — fica aberto
# ate quem relatou responder ou o time agir — e o convite nao sai.
# O valor abaixo e o do RabbitMQ do docker-compose; com a API no docker-compose,
# ele vem de la.
# RABBITMQ_URL=amqp://pds:pds@localhost:5672/


# --- opcional: armazenamento de midia ---
#
# Sem as quatro primeiras a API sobe inteira e so o anexo fica indisponivel.
# Metade delas derruba a subida, dizendo qual falta. Os valores abaixo sao os do
# MinIO do docker-compose, que roda na sua maquina. Com a API no docker-compose,
# as quatro vem de la, e as daqui nao valem.

# MEDIA_STORAGE_ENDPOINT=http://localhost:9000
# MEDIA_STORAGE_ACCESS_KEY=pds
# MEDIA_STORAGE_SECRET_KEY=pdspdspds
# MEDIA_STORAGE_BUCKET=pds-media

# Endereco com que o NAVEGADOR alcanca o armazenamento, e o unico com que se
# assina. So precisa quando e diferente do de cima — a API num container fala
# com `minio:9000`, e o navegador so conhece `localhost:9000`. Padrao: o de cima.
# MEDIA_STORAGE_PUBLIC_ENDPOINT=

# Padroes: us-east-1, true (balde no caminho), 2, 5 e 15 minutos, 20 por minuto.
# Os 15 minutos sao so dos videos antigos, que ainda tocam: o video saiu do produto.
# MEDIA_STORAGE_REGION=us-east-1
# MEDIA_STORAGE_FORCE_PATH_STYLE=true
# MEDIA_STORAGE_UPLOAD_URL_MINUTES=2
# MEDIA_STORAGE_READ_URL_MINUTES=5
# MEDIA_STORAGE_PLAYBACK_URL_MINUTES=15
# MEDIA_UPLOAD_RATE_LIMIT_PER_MINUTE=20


# --- opcional: e-mail ---
#
# O servidor SMTP que manda os e-mails. Sem nenhuma das quatro essenciais (Host,
# FromAddress, Username, Password) a API sobe inteira e so o e-mail fica
# indisponivel. Com parte delas (servidor sem remetente, usuario sem senha) a
# subida recusa, dizendo tudo o que falta. Linha em branco vale o padrao.
# Os dois sublinhados sao o separador de secao do .NET: Smtp__Host e Smtp:Host.
# So vale variavel de ambiente: uma secao Smtp no appsettings.json e ignorada.
#
# O servidor do projeto e o Brevo (plano gratis: 300 por dia, sem cartao). No
# painel dele, em "SMTP e API" -> aba SMTP: o Login vai em Smtp__Username, uma
# chave SMTP gerada ali vai em Smtp__Password (nao e a senha da conta), e um
# remetente verificado em "Remetentes, dominios e IPs" vai em Smtp__FromAddress.
# Sem dominio proprio, verifique o seu e-mail de sempre: o Brevo troca o dominio
# dele na hora de mandar (sai como algo@xxxx.brevosend.com), e o e-mail chega.
# A chave e segredo: peca a quem ja roda o projeto, por canal privado.
# Cada envio e um e-mail de verdade, e conta no limite do dia.
# Smtp__Host=smtp-relay.brevo.com
# Smtp__Port=587
# Smtp__Security=StartTls
# Smtp__Username=
# Smtp__Password=
# Smtp__FromAddress=
# Smtp__FromName=

# Outro provedor e trocar os valores: a porta e a seguranca que ele pedir (587 e
# StartTls e o comum; 465 e SslOnConnect). Usuario e senha vem sempre juntos, e
# senha com Security=None e recusada: iria em texto aberto.
# Padroes: porta 587, StartTls, 30 segundos (de 1 a 300).
# Smtp__TimeoutSeconds=30


# --- opcional: o convite ---
#
# O convite para o time precisa de tres pecas: o e-mail (acima), a fila e o
# endereco do painel, que vai no link do e-mail. Faltando qualquer uma, a API
# sobe e a tela de Membros diz qual falta. Endereco que nao e http(s) completo,
# ou que traz ? ou #, derruba a subida.
# PANEL_URL=http://localhost:5173

# Convites por projeto por hora, os novos e os reenviados somados. Padrao 20.
# INVITATION_EMAILS_PER_HOUR=20


# --- opcional: API atras de proxy ---
#
# Proxies cujo X-Forwarded-For vale, separados por virgula: endereco (10.0.0.5)
# ou rede (10.0.0.0/8). Vazio, o cabecalho e ignorado e o IP e o da conexao —
# o certo rodando local. Valor que nao e endereco nem rede derruba a subida.
# TRUSTED_PROXIES=
